{
  "name": "Vision Accessibility Suite",
  "version": "1.0.0",
  "description": "Vision Accessibility Suite is a Figma plugin that helps designers and developers understand how their designs appear to users with various visual impairments through realistic simulations of color blindness, blur, visual field defects, and other vision conditions.",
  "main": "code.js",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "webpack --mode=development --watch",
    "build": "webpack --mode=production",
    "typecheck": "tsc --noEmit",
    "community": "node documentation/community/render.mjs"
  },
  "author": "Abhijit Chirde",
  "license": "ISC",
  "devDependencies": {
    "@figma/plugin-typings": "*",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "css-loader": "^7.1.2",
    "html-inline-script-webpack-plugin": "^3.2.1",
    "html-webpack-plugin": "^5.6.5",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0"
  }
}
